{
  "name": "@mouradisalah/express.ts",
  "version": "1.0.5",
  "description": "A TypeScript-first Express-like HTTP server framework with modern features",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MouradiSalah/express.ts.git"
  },
  "bugs": {
    "url": "https://github.com/MouradiSalah/express.ts/issues"
  },
  "homepage": "https://github.com/MouradiSalah/express.ts#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && bash scripts/fix-esm-imports.sh",
    "build:clean": "rm -rf dist && npm run build",
    "build:check": "bash -c 'echo \"✅ Build environment ready (Linux/Unix)\"' || echo \"❌ Build requires Linux/Unix environment\"",
    "prepublishOnly": "npm run build",
    "pre-commit": "lint-staged && npm run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.{ts,js,json}' 'tests/**/*.{ts,js,json}' '*.{js,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}' 'tests/**/*.{ts,js,json}' '*.{js,json,md}'",
    "check": "npm run lint && npm run format:check && npm run test",
    "dev:example": "nodemon --watch 'examples/**/*.ts' --exec 'node --import tsx examples/basic-usage.ts'",
    "start:example": "node --import tsx examples/server.ts",
    "validate": "bash scripts/validate-workflow.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "typescript",
    "express",
    "server",
    "http",
    "framework",
    "middleware",
    "routing",
    "body-parser"
  ],
  "author": "Salah Eddine Mouradi <sallah.mouradi19@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  }
}
